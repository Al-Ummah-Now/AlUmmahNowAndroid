<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aun" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aun_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Aun.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aun_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/aun_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Aun</item>
    </style>
    <color name="aun_night">#FF093041</color>
</resources>
