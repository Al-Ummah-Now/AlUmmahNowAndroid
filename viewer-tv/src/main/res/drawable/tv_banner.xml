<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 dp Android TV / Fire TV launcher banner: night sky with the lantern on the start side. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF083F58"
                android:startColor="#FF07425A" />
        </shape>
    </item>
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="center">
        <bitmap android:src="@drawable/aun_logo" />
    </item>
</layer-list>
